# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Vite / tooling caches
.vite/
test-results/
playwright-report/
*.tsbuildinfo

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Audio working files
# The premixed MP3 and the WAV masters are tracked; exported stem archives are not.
bgm/**/*.zip

# Local environment. Every .env is ignored, not just the local ones: SENTRY_AUTH_TOKEN
# is a write credential and .env.production is a file Vite reads by default.
.env
.env.*
!.env.example
