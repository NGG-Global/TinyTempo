{
  "name": "tiny-tempo",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first Phaser 4 game project (portrait, touch-first, Android as target platform)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests --deny-warnings",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "build:release": "SENTRY_UPLOAD=1 npm run build && node scripts/check-no-sourcemaps.mjs",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "music:encode": "node scripts/encode-music.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "android:sync": "npm run build && NODE_OPTIONS='--experimental-strip-types' npx cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-android.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-firebase/analytics": "^8.5.2",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@revenuecat/purchases-capacitor": "^13.5.1",
    "@sentry/browser": "^10.75.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor/cli": "^8.5.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "^26.5.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
