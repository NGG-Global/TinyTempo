<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- android:appCategory="game" is what keeps the portrait lock on a tablet. An app
         targeting API 36 has screenOrientation ignored on any display of sw600dp or more,
         and games are the documented exception (developer.android.com, "Behavior changes:
         Apps targeting Android 16"). Without it a tablet ran the game at 2048 x 1280
         logical units in landscape, with every screen laid out for portrait. See
         docs/TABLETS.md. Ignored below API 26, where the lock always held. -->
    <application
        android:name=".TinyTempoApplication"
        android:appCategory="game"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Play Billing needs standard or singleTop: singleTask tears the activity down and
             back up when a purchase returns from the Play sheet or a bank app, which loses
             the flow the PurchasesUpdatedListener is waiting on. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTop"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- The live AdMob app id, indirected through @string/admob_app_id so the Android
             side has one place to edit. Must match ADMOB.appId in src/config/ads.ts. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- Google Analytics for Firebase collects nothing until the game applies the player's
             answer (src/analytics/boot.ts → setFirebaseConsent): collection starts off, and so
             does every consent-mode signal. The game grants analytics_storage at runtime when
             the player's answer is yes; the advertising signals stay denied, because analytics
             consent is never advertising consent. scripts/check-android-config.mjs checks
             these five are here. -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_analytics_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />

        <!-- Play Games Services v2. The value is the numeric Games project id; see
             @string/game_services_project_id for why it is none of the other ids. -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- navigator.vibrate() for the Haptics switch in Settings. Normal permission: granted
         at install with no runtime prompt, and silently ignored where the hardware is absent. -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
