<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above, which splits the two cases that used to share one rule set.
  Both carry the game's saves: cloud-backup is the new-phone-from-Google-backup path,
  device-transfer is a phone-to-phone copy. Same narrowing as backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
